<Window x:Class="VORTEX.UI.LibraryItemDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Adicionar à Vortex Library" Icon="Assets/vortex.ico"
        Width="760" Height="720" MinWidth="680" MinHeight="580"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#050505" Foreground="#FFFFFF">
    <Grid Margin="26">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="ADICIONAR RECURSO" Foreground="#9B87FF" FontSize="10" FontWeight="Bold"/>
            <TextBlock Text="Cadastro inteligente" FontSize="25" FontWeight="SemiBold" Margin="0,4,0,0"/>
            <TextBlock Text="Os metadados permitem que a IA encontre o recurso sem abrir todos os arquivos."
                       Foreground="#8D8D8D" Margin="0,5,0,18"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="0,0,10,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.ColumnSpan="2" Margin="0,0,0,14">
                    <TextBlock Text="Arquivo, pasta ou projeto" Foreground="#A0A0A0" FontSize="11"/>
                    <Grid Margin="0,5,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="SourcePathBox" Padding="11,9" Background="#101010" Foreground="White" CaretBrush="White" BorderBrush="#363636"/>
                        <Button Grid.Column="1" Content="Arquivo" Click="SelectFile_Click" Padding="13,8" Margin="8,0,0,0"/>
                        <Button Grid.Column="2" Content="Pasta" Click="SelectFolder_Click" Padding="13,8" Margin="8,0,0,0"/>
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,0,8,14"><TextBlock Text="Nome"/><TextBox x:Name="NameBox" Padding="10,8" Margin="0,5,0,0"/></StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,14"><TextBlock Text="Categoria"/><ComboBox x:Name="CategoryBox" IsEditable="True" Padding="9" Margin="0,5,0,0"/></StackPanel>
                <StackPanel Grid.Row="2" Margin="0,0,8,14"><TextBlock Text="Subcategoria"/><TextBox x:Name="SubcategoryBox" Padding="10,8" Margin="0,5,0,0"/></StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="1" Margin="8,0,0,14"><TextBlock Text="Tipo"/><TextBox x:Name="TypeBox" Padding="10,8" Margin="0,5,0,0" ToolTip="Ex.: componente, template, API, script"/></StackPanel>
                <StackPanel Grid.Row="3" Margin="0,0,8,14"><TextBlock Text="Framework"/><TextBox x:Name="FrameworkBox" Padding="10,8" Margin="0,5,0,0"/></StackPanel>
                <StackPanel Grid.Row="3" Grid.Column="1" Margin="8,0,0,14"><TextBlock Text="Plataforma"/><TextBox x:Name="PlatformBox" Padding="10,8" Margin="0,5,0,0"/></StackPanel>
                <StackPanel Grid.Row="4" Margin="0,0,8,14"><TextBlock Text="Tags"/><TextBox x:Name="TagsBox" Padding="10,8" Margin="0,5,0,0" ToolTip="Separe por vírgulas"/></StackPanel>
                <StackPanel Grid.Row="4" Grid.Column="1" Margin="8,0,0,14"><TextBlock Text="Dependências"/><TextBox x:Name="DependenciesBox" Padding="10,8" Margin="0,5,0,0" ToolTip="Separe por vírgulas"/></StackPanel>
                <StackPanel Grid.Row="5" Margin="0,0,8,14"><TextBlock Text="Versão"/><TextBox x:Name="VersionBox" Text="1.0.0" Padding="10,8" Margin="0,5,0,0"/></StackPanel>
                <StackPanel Grid.Row="5" Grid.Column="1" Margin="8,0,0,14"><TextBlock Text="Autor"/><TextBox x:Name="AuthorBox" Padding="10,8" Margin="0,5,0,0"/></StackPanel>
                <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Margin="0,0,0,14"><TextBlock Text="Descrição"/><TextBox x:Name="DescriptionBox" AcceptsReturn="True" TextWrapping="Wrap" Height="62" Padding="10,8" Margin="0,5,0,0"/></StackPanel>
                <StackPanel Grid.Row="7" Margin="0,0,8,14"><TextBlock Text="Quando usar"/><TextBox x:Name="WhenUseBox" AcceptsReturn="True" TextWrapping="Wrap" Height="62" Padding="10,8" Margin="0,5,0,0"/></StackPanel>
                <StackPanel Grid.Row="7" Grid.Column="1" Margin="8,0,0,14"><TextBlock Text="Quando evitar"/><TextBox x:Name="WhenAvoidBox" AcceptsReturn="True" TextWrapping="Wrap" Height="62" Padding="10,8" Margin="0,5,0,0"/></StackPanel>
                <StackPanel Grid.Row="8" Grid.ColumnSpan="2"><TextBlock Text="Compatibilidade, exemplos, licença e observações"/><TextBox x:Name="NotesBox" AcceptsReturn="True" TextWrapping="Wrap" Height="72" Padding="10,8" Margin="0,5,0,0"/></StackPanel>
            </Grid>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancelar" Click="Cancel_Click" Padding="18,9" Margin="0,0,9,0"/>
            <Button Content="Salvar na Biblioteca" Click="Save_Click" Padding="18,9"
                    Background="#FFFFFF" Foreground="#000000" BorderBrush="#FFFFFF"/>
        </StackPanel>
    </Grid>
</Window>
