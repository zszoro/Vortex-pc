<Page x:Class="VORTEX.UI.SettingsIAPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:VORTEX.UI"
      Title="Configurações de IA" Background="#101522" Foreground="#F3F6FC">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30,24">
            <TextBlock Text="Cérebro do VORTEX" FontSize="23" FontWeight="SemiBold"
                       Foreground="#F3F6FC"/>
            <TextBlock Text="Escolha o provedor, o modelo e a credencial usada pelo agente."
                       Foreground="#9AA5B7" Margin="0,7,0,24"/>

            <Border Background="#182030" BorderBrush="#26334A" BorderThickness="1"
                    CornerRadius="13" Padding="17" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Provedor ativo" Foreground="#F3F6FC"
                               FontWeight="SemiBold" Margin="0,0,0,9"/>
                    <ComboBox ItemsSource="{Binding Providers}" SelectedItem="{Binding SelectedProvider}"
                              HorizontalAlignment="Stretch" Padding="8"/>
                </StackPanel>
            </Border>

            <Border Background="#182030" BorderBrush="#26334A" BorderThickness="1"
                    CornerRadius="13" Padding="17" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Modelo de linguagem" Foreground="#F3F6FC"
                               FontWeight="SemiBold" Margin="0,0,0,9"/>
                    <ComboBox ItemsSource="{Binding OpenRouterModels}" IsEditable="True"
                              Text="{Binding SelectedModel, UpdateSourceTrigger=PropertyChanged}"
                              Foreground="#FFFFFF" Background="#101522" Padding="8"/>
                    <TextBlock Text="openrouter/free seleciona automaticamente um modelo gratuito compatível."
                               Foreground="#8490A3" FontSize="11" Margin="0,7,0,0"/>
                    <CheckBox Content="Fallback automático entre modelos gratuitos"
                              IsChecked="{Binding AutoFallback}" Foreground="#FFFFFF"
                              Margin="0,13,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="#182030" BorderBrush="#26334A" BorderThickness="1"
                    CornerRadius="13" Padding="17">
                <StackPanel>
                    <TextBlock Text="Chave de API" Foreground="#F3F6FC"
                               FontWeight="SemiBold" Margin="0,0,0,9"/>
                    <PasswordBox local:PasswordBoxAssistant.BoundPassword="{Binding ApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Background="#101010" Foreground="White" BorderBrush="#444444"
                                 Padding="10,8"/>
                    <TextBlock Text="A credencial é protegida pelo Windows para o seu usuário."
                               Foreground="#8490A3" FontSize="11" Margin="0,7,0,0"/>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <ui:Button Content="Testar conexão" Command="{Binding TestConnectionCommand}"
                           Margin="0,0,10,0" Padding="16,8"/>
                <ui:Button Content="Salvar" Command="{Binding FinishSetupCommand}"
                           Appearance="Primary" Padding="20,8"/>
            </StackPanel>
            <TextBlock Text="{Binding ConnectionStatus}" Foreground="#71E8FF"
                       HorizontalAlignment="Right" Margin="0,10,0,0"/>
        </StackPanel>
    </ScrollViewer>
</Page>
