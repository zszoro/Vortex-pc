<Page x:Class="VORTEX.UI.SettingsIAPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Configurações de IA">
    
    <ScrollViewer>
        <StackPanel Margin="40,20">
            <TextBlock Text="Cérebro do VORTEX" FontSize="24" FontWeight="Bold" Margin="0,0,0,10"/>
            <TextBlock Text="Configure como o VORTEX processa informações e qual modelo ele utiliza." Opacity="0.6" Margin="0,0,0,30"/>
            
            <ui:Card Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Provedor Ativo" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <ComboBox ItemsSource="{Binding Providers}" SelectedItem="{Binding SelectedProvider}" HorizontalAlignment="Stretch"/>
                </StackPanel>
            </ui:Card>

            <ui:Card Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Modelo de Linguagem" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <ui:TextBox Text="{Binding SelectedModel}" PlaceholderText="Ex: openai/gpt-oss-120b" HorizontalAlignment="Stretch"/>
                    <TextBlock Text="O modelo 'openai/gpt-oss-120b' é o recomendado para esta versão." FontSize="11" Opacity="0.5" Margin="0,5,0,0"/>
                </StackPanel>
            </ui:Card>

            <ui:Card Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Chave de API (API Key)" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <ui:PasswordBox Password="{Binding ApiKey}" HorizontalAlignment="Stretch"/>
                    <TextBlock Text="Sua chave é armazenada localmente e criptografada." FontSize="11" Opacity="0.5" Margin="0,5,0,0"/>
                </StackPanel>
            </ui:Card>
            
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <ui:Button Content="Testar Conexão" Command="{Binding TestConnectionCommand}" Margin="0,0,10,0"/>
                <ui:Button Content="Salvar Alterações" Command="{Binding FinishSetupCommand}" Appearance="Primary" Padding="20,8"/>
            </StackPanel>
            
            <TextBlock Text="{Binding ConnectionStatus}" HorizontalAlignment="Right" Margin="0,10,0,0" 
                       FontWeight="SemiBold" Foreground="{ui:ThemeResource SystemAccentColorPrimaryBrush}"/>
        </StackPanel>
    </ScrollViewer>
</Page>
