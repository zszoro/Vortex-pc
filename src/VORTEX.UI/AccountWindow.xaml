<Window x:Class="VORTEX.UI.AccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Conta VORTEX" Width="780" Height="610"
        MinWidth="680" MinHeight="540" Background="#000000"
        Foreground="White" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="34">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,22">
            <TextBlock Text="Conta VORTEX" FontSize="28" FontWeight="SemiBold"/>
            <TextBlock x:Name="SessionText" Text="Entre ou crie uma conta local."
                       Foreground="#A0A0A0" Margin="0,6,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Background="#101010" BorderBrush="#363636" BorderThickness="1"
                    CornerRadius="18" Padding="22">
                <StackPanel>
                    <TextBlock Text="Entrar" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="E-mail" Margin="0,20,0,6"/>
                    <TextBox x:Name="LoginEmail" Padding="10,8"/>
                    <TextBlock Text="Senha" Margin="0,14,0,6"/>
                    <PasswordBox x:Name="LoginPassword" Padding="10,8"
                                 Background="#000000" Foreground="White" BorderBrush="#444444"/>
                    <Button Content="Entrar" Click="Login_Click" Margin="0,20,0,0"
                            Padding="14,10" Background="#7C3AED" Foreground="White"/>
                    <Button Content="Sair da conta" Click="Logout_Click" Margin="0,10,0,0"
                            Padding="14,9" Background="#181818" Foreground="White"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="#101010" BorderBrush="#363636"
                    BorderThickness="1" CornerRadius="18" Padding="22">
                <StackPanel>
                    <TextBlock Text="Criar ou editar perfil" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="Nome" Margin="0,18,0,6"/>
                    <TextBox x:Name="ProfileName" Padding="10,8"/>
                    <TextBlock Text="E-mail para nova conta" Margin="0,12,0,6"/>
                    <TextBox x:Name="RegisterEmail" Padding="10,8"/>
                    <TextBlock Text="Senha para nova conta" Margin="0,12,0,6"/>
                    <PasswordBox x:Name="RegisterPassword" Padding="10,8"
                                 Background="#000000" Foreground="White" BorderBrush="#444444"/>
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Content="Escolher foto" Click="ChooseAvatar_Click"
                                Padding="12,8" Background="#181818" Foreground="White"/>
                        <TextBlock x:Name="AvatarText" Text="Nenhuma foto"
                                   Foreground="#909090" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" Width="130" Margin="10,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                        <Button Content="Cadastrar" Click="Register_Click"
                                Padding="13,9" Background="#7C3AED" Foreground="White"/>
                        <Button Content="Salvar perfil" Click="SaveProfile_Click"
                                Padding="13,9" Margin="10,0,0,0"
                                Background="#242424" Foreground="White"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
