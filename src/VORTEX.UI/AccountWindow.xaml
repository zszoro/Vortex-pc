<Window x:Class="VORTEX.UI.AccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Conta VORTEX" Width="940" Height="640"
        MinWidth="860" MinHeight="580" Background="#000000"
        Foreground="White" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Window.Resources>
        <SolidColorBrush x:Key="AuthPanelBrush" Color="#0B0B0B"/>
        <SolidColorBrush x:Key="AuthFieldBrush" Color="#000000"/>
        <SolidColorBrush x:Key="AuthBorderBrush" Color="#2A2A2A"/>
        <SolidColorBrush x:Key="AuthMutedBrush" Color="#9B9B9B"/>

        <Style x:Key="AuthFieldStyle" TargetType="TextBox">
            <Setter Property="Height" Value="48"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="Background" Value="{StaticResource AuthFieldBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AuthBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="FieldBorder" CornerRadius="10"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FieldBorder" Property="BorderBrush" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AuthPasswordStyle" TargetType="PasswordBox">
            <Setter Property="Height" Value="48"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource AuthFieldBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AuthBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="FieldBorder" CornerRadius="10"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FieldBorder" Property="BorderBrush" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WhiteButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="50"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" CornerRadius="11"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#E7E7E7"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#CFCFCF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButtonStyle" TargetType="Button" BasedOn="{StaticResource WhiteButtonStyle}">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#151515"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource AuthMutedBrush}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,12"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid>
                            <Border x:Name="TabBackground" CornerRadius="9" Background="Transparent">
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <Border x:Name="SelectedLine" Height="3" Margin="12,0"
                                    VerticalAlignment="Bottom" CornerRadius="2"
                                    Background="#FFFFFF" Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBackground" Property="Background" Value="#14FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                                <Setter TargetName="SelectedLine" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="#000000">
        <Border Margin="36" CornerRadius="26" BorderBrush="#303030"
                BorderThickness="1" Background="#D9040404">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.05*"/>
                    <ColumnDefinition Width="0.95*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="54">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <Image Source="/VORTEX.UI;component/Assets/vortex-pet.png"
                               Width="56" Height="56" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="VORTEX" FontSize="22" FontWeight="Bold"/>
                            <TextBlock Text="Conta local" FontSize="11" Foreground="{StaticResource AuthMutedBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="1" VerticalAlignment="Center" MaxWidth="470">
                        <TextBlock Text="Sua IA pessoal," FontSize="42" FontWeight="Light"/>
                        <TextBlock Text="sempre ao seu lado." Margin="0,2,0,0"
                                   FontSize="42" FontWeight="Bold" Foreground="#FFFFFF"/>
                        <TextBlock x:Name="SessionText" Margin="0,20,0,0"
                                   TextWrapping="Wrap" FontSize="16" LineHeight="25"
                                   Foreground="{StaticResource AuthMutedBrush}"/>
                        <StackPanel Margin="0,34,0,0">
                            <TextBlock Text="+ Conversas protegidas neste PC" Margin="0,0,0,14" Foreground="#D8D8D8"/>
                            <TextBlock Text="+ Preferencias e perfil local" Margin="0,0,0,14" Foreground="#D8D8D8"/>
                            <TextBlock Text="+ Controle direto pelo VORTEX" Foreground="#D8D8D8"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Grid.Row="2" Text="VORTEX - Inteligencia que trabalha com voce"
                               FontSize="12" Foreground="#777777"/>
                </Grid>

                <Border Grid.Column="1" Margin="24" Padding="42,34"
                        CornerRadius="22" Background="{StaticResource AuthPanelBrush}"
                        BorderBrush="#2A2A2A" BorderThickness="1">
                    <TabControl Background="Transparent" BorderThickness="0">
                        <TabItem Header="Entrar">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="4,30,4,4">
                                    <TextBlock Text="Bem-vindo de volta" FontSize="27" FontWeight="SemiBold"/>
                                    <TextBlock Margin="0,7,0,28" Text="Acesse sua conta para continuar."
                                               Foreground="{StaticResource AuthMutedBrush}"/>
                                    <TextBlock Text="E-mail" Margin="0,0,0,7"/>
                                    <TextBox x:Name="LoginEmail" Style="{StaticResource AuthFieldStyle}"/>
                                    <TextBlock Text="Senha" Margin="0,18,0,7"/>
                                    <PasswordBox x:Name="LoginPassword" Style="{StaticResource AuthPasswordStyle}"/>
                                    <Button Margin="0,27,0,0" Content="Entrar no VORTEX"
                                            Style="{StaticResource WhiteButtonStyle}" Click="Login_Click"/>
                                    <Button Margin="0,12,0,0" Content="Sair da conta"
                                            Style="{StaticResource GhostButtonStyle}" Click="Logout_Click"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="Cadastre-se">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="4,30,4,4">
                                    <TextBlock Text="Crie sua conta" FontSize="27" FontWeight="SemiBold"/>
                                    <TextBlock Margin="0,7,0,25" Text="Comece a usar sua IA pessoal."
                                               Foreground="{StaticResource AuthMutedBrush}"/>
                                    <TextBlock Text="Nome" Margin="0,0,0,7"/>
                                    <TextBox x:Name="ProfileName" Style="{StaticResource AuthFieldStyle}"/>
                                    <TextBlock Text="E-mail" Margin="0,16,0,7"/>
                                    <TextBox x:Name="RegisterEmail" Style="{StaticResource AuthFieldStyle}"/>
                                    <TextBlock Text="Senha" Margin="0,16,0,7"/>
                                    <PasswordBox x:Name="RegisterPassword" Style="{StaticResource AuthPasswordStyle}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                        <Button Content="Escolher foto" Click="ChooseAvatar_Click"
                                                Padding="14,8" Height="38"
                                                Style="{StaticResource GhostButtonStyle}"/>
                                        <TextBlock x:Name="AvatarText" Text="Nenhuma foto"
                                                   Foreground="{StaticResource AuthMutedBrush}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   Width="160" Margin="10,0,0,0"/>
                                    </StackPanel>
                                    <Button Margin="0,25,0,0" Content="Criar minha conta"
                                            Style="{StaticResource WhiteButtonStyle}" Click="Register_Click"/>
                                    <Button Margin="0,12,0,0" Content="Salvar perfil"
                                            Style="{StaticResource GhostButtonStyle}" Click="SaveProfile_Click"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
