<ui:FluentWindow x:Class="VORTEX.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:VORTEX.UI"
        Title="Configurações VORTEX" Height="650" Width="900"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <ListBox x:Name="SettingsMenu" Grid.Column="0" Background="Transparent" BorderThickness="0" Padding="8">
            <ListBoxItem Content="Inteligência Artificial"/>
            <ListBoxItem Content="Personalização"/>
            <ListBoxItem Content="Companion &amp; Atalhos"/>
            <ListBoxItem Content="Sobre o VORTEX"/>
        </ListBox>

        <Frame x:Name="SettingsFrame" Grid.Column="1"/>
    </Grid>
</ui:FluentWindow>
