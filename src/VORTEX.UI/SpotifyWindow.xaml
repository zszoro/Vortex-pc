<Window x:Class="VORTEX.UI.SpotifyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Spotify no VORTEX" Icon="Assets/vortex.ico"
        Width="720" Height="560" MinWidth="620" MinHeight="500"
        WindowStartupLocation="CenterOwner" Background="#0B0B0D"
        Foreground="#FFFFFF">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid Width="58" Height="58">
                <Ellipse Fill="#1ED760"/>
                <TextBlock Text="≋" FontSize="42" FontWeight="Bold" Foreground="#0B0B0D"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Margin="0,-9,0,0"/>
            </Grid>
            <StackPanel Grid.Column="1" Margin="16,0">
                <TextBlock Text="Spotify × VORTEX" FontSize="26" FontWeight="Bold"/>
                <TextBlock x:Name="ConnectionText" Text="Conecte sua conta quando quiser usar música."
                           Foreground="#A7A7A7" Margin="0,5,0,0"/>
            </StackPanel>
            <Button Grid.Column="2" x:Name="ConnectButton" Content="Conectar Spotify"
                    Click="Connect_Click" Background="#1ED760" Foreground="#08140C"
                    FontWeight="Bold" Padding="18,10" BorderThickness="0"/>
        </Grid>

        <Border Grid.Row="1" Background="#111111" CornerRadius="24" Margin="0,18,0,14"
                BorderBrush="#3A3A3A" BorderThickness="1" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="120" Height="120" CornerRadius="20" Background="#24242A">
                        <Grid>
                            <Image x:Name="AlbumArt" Stretch="UniformToFill"/>
                            <Ellipse Width="75" Height="75" Fill="#1ED760" Opacity=".14"/>
                            <TextBlock x:Name="FallbackNote" Text="♫" FontSize="52" Foreground="#1ED760"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <TextBlock x:Name="TrackText" Text="Nenhuma música ativa"
                               FontSize="23" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,12,0,5"/>
                    <TextBlock x:Name="ArtistText" Text="—" Foreground="#A7A7A7"
                               FontSize="14" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="AlbumText" Text="" Foreground="#77777F"
                               FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    <Slider x:Name="ProgressSlider" Minimum="0" Maximum="100"
                            Width="380" Margin="0,7,0,0"
                            PreviewMouseLeftButtonUp="ProgressSlider_Commit"/>
                    <Grid Width="380">
                        <TextBlock x:Name="ProgressText" Text="0:00"/>
                        <TextBlock x:Name="DurationText" Text="0:00" HorizontalAlignment="Right"/>
                    </Grid>
                </StackPanel>
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="⏮" Click="Previous_Click" ToolTip="Faixa anterior"
                            Width="50" Height="44" Margin="5" FontSize="18"/>
                    <Button x:Name="PlayButton" Content="▶" Click="PlayPause_Click"
                            ToolTip="Tocar ou pausar" Width="58" Height="50" Margin="5"
                            FontSize="20" Background="#1ED760" Foreground="#07120A"/>
                    <Button Content="⏭" Click="Next_Click" ToolTip="Próxima faixa"
                            Width="50" Height="44" Margin="5" FontSize="18"/>
                    <Button Content="↻" Click="Refresh_Click" ToolTip="Atualizar reprodução"
                            Width="50" Height="44" Margin="5" FontSize="20"/>
                    <Button x:Name="ShuffleButton" Content="⤨" Click="Shuffle_Click"
                            ToolTip="Alternar shuffle" Width="50" Height="44" Margin="5"/>
                    <Button x:Name="RepeatButton" Content="⟳" Click="Repeat_Click"
                            ToolTip="Alternar repetição" Width="50" Height="44" Margin="5"/>
                </StackPanel>
                <Grid Grid.Row="2" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="190"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBox x:Name="SearchInput" Background="#090909" Foreground="#FFFFFF"
                                 Padding="10,7" ToolTip="Pesquisar músicas, artistas, álbuns e playlists"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Pesquisar" Click="Search_Click" Padding="10,5"/>
                            <Button Content="Playlists" Click="Playlists_Click" Padding="10,5" Margin="7,0"/>
                            <Button Content="Curtidas" Click="Liked_Click" Padding="10,5"/>
                            <Button Content="Recentes" Click="Recent_Click" Padding="10,5" Margin="7,0"/>
                        </StackPanel>
                        <ListBox x:Name="LibraryList" Height="100" Margin="0,8,0,0"
                                 Background="#090909" Foreground="#FFFFFF"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="20,0,0,0">
                        <TextBlock Text="VOLUME" FontSize="10" Foreground="#8A8A8A"/>
                        <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100"
                                PreviewMouseLeftButtonUp="VolumeSlider_Commit"/>
                        <TextBlock x:Name="DeviceText" Text="Sem dispositivo"
                                   TextWrapping="Wrap" Foreground="#A0A0A0" Margin="0,12,0,0"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
        <TextBlock Grid.Row="2" Text="O painel permanece fechado até você clicar no botão ou pedir ao VORTEX."
                   Foreground="#77777F" HorizontalAlignment="Center"/>
    </Grid>
</Window>
