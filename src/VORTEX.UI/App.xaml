<Application x:Class="VORTEX.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:VORTEX.UI">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>
            <local:RoleToAlignmentConverter x:Key="RoleToAlignmentConverter"/>
            <local:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>

            <Color x:Key="VortexBackground">#030303</Color>
            <Color x:Key="VortexSurface">#0D0D0D</Color>
            <Color x:Key="VortexCyan">#55E6FF</Color>
            <Color x:Key="VortexViolet">#8B7CFF</Color>
            <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource VortexSurface}"/>
            <SolidColorBrush x:Key="VortexBackgroundBrush" Color="{StaticResource VortexBackground}"/>
            <SolidColorBrush x:Key="MutedTextBrush" Color="#A0A0A0"/>
            <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource VortexCyan}"/>
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="#FFFFFF"/>
            </Style>
            <Style TargetType="TextBox">
                <Setter Property="Foreground" Value="#FFFFFF"/>
                <Setter Property="CaretBrush" Value="#55E6FF"/>
                <Setter Property="Background" Value="#101522"/>
            </Style>

            <Style x:Key="PanelStyle" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                <Setter Property="BorderBrush" Value="#3A3A3A"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="20"/>
            </Style>
            <Style x:Key="NavButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="#D0D0D0"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Padding" Value="16,12"/>
                <Setter Property="Margin" Value="0,3"/>
                <Setter Property="Cursor" Value="Hand"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
