<Application x:Class="VORTEX.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:VORTEX.UI">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>
            <local:RoleToAlignmentConverter x:Key="RoleToAlignmentConverter"/>
            <local:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>

            <Color x:Key="VortexBackground">#070A12</Color>
            <Color x:Key="VortexSurface">#101522</Color>
            <Color x:Key="VortexCyan">#55E6FF</Color>
            <Color x:Key="VortexViolet">#8B7CFF</Color>
            <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource VortexSurface}"/>
            <SolidColorBrush x:Key="MutedTextBrush" Color="#8E99AB"/>
            <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource VortexCyan}"/>

            <Style x:Key="PanelStyle" TargetType="Border">
                <Setter Property="Background" Value="#B3101522"/>
                <Setter Property="BorderBrush" Value="#22FFFFFF"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="20"/>
            </Style>
            <Style x:Key="NavButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="#AEB8C8"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Padding" Value="16,12"/>
                <Setter Property="Margin" Value="0,3"/>
                <Setter Property="Cursor" Value="Hand"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
