<Window x:Class="VORTEX.UI.LibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vortex Library" Icon="Assets/vortex.ico"
        Width="1180" Height="760" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterOwner" Background="#000000" Foreground="#FFFFFF"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">
    <Window.Resources>
        <Style x:Key="LibraryButton" TargetType="Button">
            <Setter Property="Background" Value="#161616"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#363636"/>
            <Setter Property="Padding" Value="13,8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#292929"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="VORTEX LIBRARY" Foreground="#9B87FF" FontSize="11" FontWeight="Bold"/>
                <TextBlock Text="Biblioteca inteligente" FontSize="28" FontWeight="SemiBold" Margin="0,4,0,0"/>
                <TextBlock Text="Recursos pesquisáveis por metadados para todas as Tools do VORTEX."
                           Foreground="#929292" Margin="0,5,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Content="＋  Adicionar item" Click="AddItem_Click"
                    Style="{StaticResource LibraryButton}" Background="#FFFFFF" Foreground="#000000"
                    BorderBrush="#FFFFFF" VerticalAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="1" Margin="0,22,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" Padding="13,10" Margin="0,0,8,0"
                     Background="#0D0D0D" Foreground="White" CaretBrush="White"
                     BorderBrush="#383838" TextChanged="FilterChanged"
                     ToolTip="Pesquisar por nome, descrição, tags e uso"/>
            <ComboBox x:Name="FrameworkFilter" Grid.Column="1" Margin="0,0,8,0" Padding="9"
                      Background="#101010" Foreground="White" SelectionChanged="FilterChanged">
                <ComboBoxItem Content="Todos os frameworks" IsSelected="True"/>
                <ComboBoxItem Content="React"/><ComboBoxItem Content="Next.js"/>
                <ComboBoxItem Content="Vue"/><ComboBoxItem Content="Angular"/>
                <ComboBoxItem Content="WPF"/><ComboBoxItem Content="Electron"/>
                <ComboBoxItem Content="Flutter"/><ComboBoxItem Content="Unity"/>
            </ComboBox>
            <ComboBox x:Name="PlatformFilter" Grid.Column="2" Margin="0,0,8,0" Padding="9"
                      Background="#101010" Foreground="White" SelectionChanged="FilterChanged">
                <ComboBoxItem Content="Todas as plataformas" IsSelected="True"/>
                <ComboBoxItem Content="Web"/><ComboBoxItem Content="Windows"/>
                <ComboBoxItem Content="Android"/><ComboBoxItem Content="iOS"/>
                <ComboBoxItem Content="Multiplataforma"/>
            </ComboBox>
            <ComboBox x:Name="TypeFilter" Grid.Column="3" Margin="0,0,8,0" Padding="9"
                      Background="#101010" Foreground="White" IsEditable="True"
                      SelectionChanged="FilterChanged" LostKeyboardFocus="FilterChanged">
                <ComboBoxItem Content="Todos os tipos" IsSelected="True"/>
                <ComboBoxItem Content="Componente UI"/><ComboBoxItem Content="Template"/>
                <ComboBoxItem Content="Projeto/Pasta"/><ComboBoxItem Content="API"/>
                <ComboBoxItem Content="Script"/><ComboBoxItem Content="Prompt"/>
            </ComboBox>
            <ComboBox x:Name="SortFilter" Grid.Column="4" Margin="0,0,8,0" Padding="9"
                      Background="#101010" Foreground="White" SelectionChanged="FilterChanged">
                <ComboBoxItem Content="Relevância" IsSelected="True"/>
                <ComboBoxItem Content="Nome"/><ComboBoxItem Content="Mais recentes"/>
                <ComboBoxItem Content="Usados recentemente"/>
            </ComboBox>
            <StackPanel Grid.Column="5" Orientation="Horizontal">
                <ToggleButton x:Name="FavoritesOnly" Content="★" ToolTip="Somente favoritos"
                              Checked="FilterChanged" Unchecked="FilterChanged" Padding="12,8"
                              Background="#111111" Foreground="#FFD166" BorderBrush="#383838"/>
                <Button Content="▦" Click="GridView_Click" ToolTip="Visualização em grade"
                        Style="{StaticResource LibraryButton}" Margin="8,0,0,0"/>
                <Button Content="☷" Click="ListView_Click" ToolTip="Visualização em lista"
                        Style="{StaticResource LibraryButton}" Margin="0"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>
            <Border Background="#090909" BorderBrush="#303030" BorderThickness="1"
                    CornerRadius="14" Padding="10" Margin="0,0,14,0">
                <DockPanel>
                    <Button DockPanel.Dock="Bottom" Content="＋ Nova categoria" Click="AddCategory_Click"
                            Style="{StaticResource LibraryButton}" Margin="0,8,0,0"/>
                    <TextBlock DockPanel.Dock="Top" Text="CATEGORIAS" Foreground="#858585"
                               FontSize="10" FontWeight="Bold" Margin="8,5,8,9"/>
                    <ListBox x:Name="CategoryList" Background="Transparent" Foreground="White"
                             BorderThickness="0" SelectionChanged="CategoryChanged"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.Resources>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="10,7"/><Setter Property="Margin" Value="0,1"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListBox.Resources>
                    </ListBox>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1">
                <ListBox x:Name="GridItems" Background="Transparent" BorderThickness="0"
                         Foreground="White" SelectionChanged="ItemSelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Width="215" Height="158" Background="#0D0D0D" BorderBrush="#333333"
                                    BorderThickness="1" CornerRadius="14" Padding="15" Margin="0,0,12,12">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <Grid>
                                        <TextBlock Text="◈" Foreground="#9B87FF" FontSize="20"/>
                                        <TextBlock Text="{Binding IsFavorite, StringFormat=★}" Foreground="#FFD166"
                                                   HorizontalAlignment="Right"/>
                                    </Grid>
                                    <StackPanel Grid.Row="1" Margin="0,8,0,0">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Description}" Foreground="#929292" FontSize="11"
                                                   TextWrapping="Wrap" MaxHeight="38" Margin="0,5,0,0"/>
                                    </StackPanel>
                                    <TextBlock Grid.Row="2" Text="{Binding Category}" Foreground="#B9ADFF" FontSize="10"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <ListView x:Name="ListItems" Visibility="Collapsed" Background="Transparent"
                          BorderThickness="0" Foreground="White" SelectionChanged="ItemSelectionChanged">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Nome" DisplayMemberBinding="{Binding Name}" Width="180"/>
                            <GridViewColumn Header="Categoria" DisplayMemberBinding="{Binding Category}" Width="120"/>
                            <GridViewColumn Header="Tipo" DisplayMemberBinding="{Binding Type}" Width="100"/>
                            <GridViewColumn Header="Framework" DisplayMemberBinding="{Binding Framework}" Width="110"/>
                            <GridViewColumn Header="Plataforma" DisplayMemberBinding="{Binding Platform}" Width="110"/>
                        </GridView>
                    </ListView.View>
                </ListView>

                <Border x:Name="EmptyState" Background="#080808" BorderBrush="#303030" BorderThickness="1"
                        CornerRadius="14" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="◇" FontSize="42" Foreground="#6F5DCC" HorizontalAlignment="Center"/>
                        <TextBlock Text="Nenhum recurso encontrado" FontSize="17" Margin="0,10,0,0"/>
                        <TextBlock Text="Adicione um arquivo, uma pasta ou arraste um projeto para cá."
                                   Foreground="#858585" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Column="2" Background="#090909" BorderBrush="#303030" BorderThickness="1"
                    CornerRadius="14" Padding="18" Margin="14,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel DataContext="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=Window}}">
                        <TextBlock Text="DETALHES" Foreground="#858585" FontSize="10" FontWeight="Bold"/>
                        <TextBlock Text="{Binding Name, TargetNullValue=Selecione um item}" FontSize="20" FontWeight="SemiBold" Margin="0,10,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Description}" Foreground="#A0A0A0" TextWrapping="Wrap" Margin="0,8,0,16"/>
                        <TextBlock Text="Categoria" Foreground="#6F6F6F" FontSize="10"/>
                        <TextBlock Text="{Binding Category}" Margin="0,3,0,11"/>
                        <TextBlock Text="Framework / Plataforma" Foreground="#6F6F6F" FontSize="10"/>
                        <TextBlock Margin="0,3,0,11"><Run Text="{Binding Framework}"/><Run Text="  •  "/><Run Text="{Binding Platform}"/></TextBlock>
                        <TextBlock Text="Quando usar" Foreground="#6F6F6F" FontSize="10"/>
                        <TextBlock Text="{Binding WhenToUse}" TextWrapping="Wrap" Margin="0,3,0,11"/>
                        <TextBlock Text="Quando evitar" Foreground="#6F6F6F" FontSize="10"/>
                        <TextBlock Text="{Binding WhenToAvoid}" TextWrapping="Wrap" Margin="0,3,0,11"/>
                        <TextBlock Text="Arquivo" Foreground="#6F6F6F" FontSize="10"/>
                        <TextBlock Text="{Binding FilePath}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="10" Margin="0,3,0,16"/>
                        <WrapPanel>
                            <Button Content="☆ Favorito" Click="Favorite_Click" Style="{StaticResource LibraryButton}"/>
                            <Button Content="Editar" Click="Edit_Click" Style="{StaticResource LibraryButton}"/>
                            <Button Content="Duplicar" Click="Duplicate_Click" Style="{StaticResource LibraryButton}"/>
                            <Button Content="Abrir pasta" Click="OpenFolder_Click" Style="{StaticResource LibraryButton}"/>
                            <Button Content="Excluir" Click="Delete_Click" Style="{StaticResource LibraryButton}" Foreground="#FF8F9A"/>
                        </WrapPanel>
                        <Button Content="Usar no projeto" Click="UseInProject_Click"
                                Style="{StaticResource LibraryButton}" Background="#FFFFFF" Foreground="#000000"
                                BorderBrush="#FFFFFF" Margin="0,10,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Grid Grid.Row="3" Margin="0,15,0,0">
            <TextBlock x:Name="StatusText" Foreground="#8E8E8E" VerticalAlignment="Center"/>
            <TextBlock Text="Arraste arquivos e pastas para importar" Foreground="#666666"
                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Window>
