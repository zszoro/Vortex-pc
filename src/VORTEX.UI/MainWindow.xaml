<Window x:Class="VORTEX.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:local="clr-namespace:VORTEX.UI"
    Title="VORTEX — Agente de desenvolvimento" Icon="Assets/vortex.ico" Height="820" Width="1480"
    MinHeight="680" MinWidth="980" WindowStartupLocation="CenterScreen"
    WindowStyle="SingleBorderWindow" ResizeMode="CanResize"
    Background="{DynamicResource VortexBackgroundBrush}">

    <Window.Resources>
        <Style x:Key="MessageCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="18,14"/>
            <Setter Property="Margin" Value="0,7"/>
            <Setter Property="MaxWidth" Value="700"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Background" Value="#CC111111"/>
            <Setter Property="BorderBrush" Value="#383838"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Role}" Value="Você">
                    <Setter Property="HorizontalAlignment" Value="Right"/>
                    <Setter Property="Background" Value="#CC171717"/>
                    <Setter Property="BorderBrush" Value="#424242"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="MessageIconButton" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="27"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#D9E2F0"/>
            <Setter Property="BorderBrush" Value="#33465F"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="1000"/>
            <Setter Property="ToolTipService.ShowDuration" Value="8000"/>
        </Style>
        <Style x:Key="HoverCardButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#14FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource VortexBackgroundBrush}">
        <Ellipse Width="700" Height="700" HorizontalAlignment="Right" VerticalAlignment="Top"
                 Margin="0,-420,-280,0" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#268B7CFF" Offset="0"/>
                    <GradientStop Color="#008B7CFF" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <Grid Margin="0,32,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="245"/>
                <ColumnDefinition Width="0"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="0"/>
                <ColumnDefinition Width="315"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#000000" BorderBrush="#333333"
                    BorderThickness="0,0,1,0" CornerRadius="0" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="6,4,0,25">
                        <Border Width="36" Height="36" CornerRadius="12" Background="#2255E6FF">
                            <TextBlock Text="V" FontSize="19" FontWeight="Black" Foreground="{StaticResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="11,0,0,0">
                            <TextBlock Text="V O R T E X" FontSize="15" FontWeight="Bold"/>
                            <TextBlock Text="P E R S O N A L  A G E N T" FontSize="7" Foreground="{StaticResource MutedTextBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="0,0,0,16">
                        <Button Content="+  Nova conversa" Click="NewConversation_Click"
                                Background="#1E55E6FF" Foreground="#DFFAFF" BorderBrush="#4455E6FF"
                                BorderThickness="1" Padding="14,11" Margin="0,0,0,10"/>
                        <Border Background="#000000" BorderBrush="#353535" BorderThickness="1"
                                CornerRadius="10" Padding="10,7" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="⌕" FontSize="18" Foreground="#A0A0A0"
                                           VerticalAlignment="Center" Margin="2,0,8,0"/>
                                <TextBox Grid.Column="1" x:Name="ConversationSearch"
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="White" CaretBrush="White"
                                         ToolTip="Pesquisar conversas"
                                         TextChanged="ConversationSearch_TextChanged"/>
                            </Grid>
                        </Border>
                        <Border Background="#101B2B" CornerRadius="10" Padding="10">
                            <StackPanel>
                                <TextBlock Text="WORKSPACE" FontSize="8" Foreground="#55E6FF"
                                           FontWeight="Bold"/>
                                <TextBlock Text="{Binding WorkspaceName}" FontSize="11"
                                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                           Margin="0,3,0,0"/>
                                <TextBlock Text="{Binding WorkspacePath}" FontSize="8"
                                           Foreground="#7E899B" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  PanningMode="VerticalOnly">
                    <StackPanel>
                        <Button Style="{StaticResource NavButtonStyle}" Content="●  Conversa" Click="FocusChat_Click"/>
                        <Button Style="{StaticResource NavButtonStyle}" Content="◈  Memória" Click="Memory_Click"/>
                        <Button Style="{StaticResource NavButtonStyle}" Content="⌁  Automações" Click="Automations_Click"/>
                        <Button Style="{StaticResource NavButtonStyle}" Content="●  Spotify"
                                Foreground="#1ED760" Click="Spotify_Click"/>
                        <Button Style="{StaticResource NavButtonStyle}" Content="✦  Planejamento"
                                Foreground="#B7A9FF" Click="Planning_Click"/>
                        <Button Style="{StaticResource NavButtonStyle}" Content="▣  Meus arquivos" Click="Files_Click"/>
                        <Button Style="{StaticResource NavButtonStyle}" Content="↶  Backups" Click="Backups_Click"/>
                        <Button Style="{StaticResource NavButtonStyle}" Content="›_  Terminal" Click="Terminal_Click"/>
                        <Button Style="{StaticResource NavButtonStyle}" Content="✣  Testar Computer Use"
                                Foreground="#C4B5FD" Click="TestComputerUse_Click"
                                ToolTip="Move o cursor VORTEX até minimizar e encerra o teste"/>
                        <Button Style="{StaticResource NavButtonStyle}" Content="◇  Resumir conversa" Click="Summarize_Click"/>
                        <Border Background="#0A0A0A" BorderBrush="#383838" BorderThickness="1"
                                CornerRadius="12" Padding="10" Margin="0,12,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding SpotifyTrack}" FontSize="11"
                                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding SpotifyArtist}" FontSize="9"
                                               Foreground="#8A8A8A" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,7,0,0">
                                    <Button Content="▶/Ⅱ" Command="{Binding SpotifyPlayPauseCommand}"
                                            ToolTip="Tocar ou pausar" Width="48" Height="25"
                                            FontSize="9" Background="#1ED760" Foreground="#050505"/>
                                    <Button Content="⏭" Command="{Binding SpotifyNextCommand}"
                                            ToolTip="Próxima faixa" Width="34" Height="25"
                                            Margin="6,0,0,0" Background="#171717"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="3" Background="#0EFFFFFF" CornerRadius="14" Padding="12"
                            Cursor="Hand" MouseLeftButtonUp="Account_Click"
                            ToolTip="Abrir conta e perfil">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="9" Height="9" Fill="#43E6A0" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Margin="9,0">
                                <TextBlock Text="{Binding UserName}" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Text="Sistema pronto" Foreground="{StaticResource MutedTextBrush}" FontSize="10"/>
                            </StackPanel>
                            <ui:Button Grid.Column="2" Icon="{ui:SymbolIcon Settings20}" Appearance="Transparent"
                                       Click="Settings_Click"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="#000000" BorderThickness="0" CornerRadius="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="104"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="18,0,24,0" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <local:VortexCore State="{Binding Status}" Appearance="{Binding PetAppearance}" Width="112" Height="112"
                                          VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Conversa principal" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock FontSize="10" Foreground="#FFFFFF">
                                <Run Text="{Binding ActiveModel}"/><Run Text="  •  "/>
                                <Run Text="{Binding ConnectionStatus}"/><Run Text="  •  contexto "/>
                                <Run Text="{Binding ContextUsage}"/><Run Text="  •  "/>
                                <Run Text="{Binding ResponseTime}"/>
                            </TextBlock>
                        </StackPanel>
                        <Border Grid.Column="2" HorizontalAlignment="Right" Background="#1043E6A0" BorderBrush="#3043E6A0"
                                BorderThickness="1" CornerRadius="12" Padding="12,7">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="#43E6A0" Margin="0,0,7,0"/>
                                <TextBlock Text="{Binding Status}" FontSize="11" Foreground="#A7F7CF"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border x:Name="UpdateBanner" Grid.Row="1" Visibility="Collapsed"
                            Background="#251F5FBF" BorderBrush="#5555E6FF" BorderThickness="1"
                            CornerRadius="12" Margin="24,0,24,8" Padding="14,10">
                        <Grid>
                            <StackPanel>
                                <TextBlock x:Name="UpdateBannerTitle" Text="Atualização do VORTEX disponível"
                                           FontWeight="SemiBold" Foreground="#BFF5FF"/>
                                <TextBlock x:Name="UpdateBannerNotes" FontSize="10" Foreground="#91A9BD"
                                           TextTrimming="CharacterEllipsis" Margin="0,3,120,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Agora não" Click="DismissUpdate_Click" Padding="10,5" Margin="0,0,7,0"/>
                                <Button Content="Atualizar" Click="OpenUpdate_Click" Padding="12,5"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding Messages.Count, Converter={StaticResource CountToVisibilityConverter}}">
                            <local:VortexCore State="{Binding Status}" Appearance="{Binding PetAppearance}" Width="220" Height="220"/>
                            <TextBlock Text="O que vamos construir hoje?" FontSize="24" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,18,0,7"/>
                            <TextBlock Text="Pergunte, planeje ou transforme uma ideia em ação."
                                       Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <ListView x:Name="MessageList" ItemsSource="{Binding Messages}" Background="Transparent"
                                  BorderThickness="0" Padding="34,14"
                                  ScrollViewer.CanContentScroll="False"
                                  ScrollViewer.PanningMode="VerticalOnly"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Focusable" Value="False"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListViewItem">
                                                <Border Background="Transparent" Padding="0">
                                                    <ContentPresenter/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource MessageCard}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Role}" FontSize="10" FontWeight="Bold"
                                                       Foreground="{StaticResource AccentBrush}" Margin="0,0,0,6"/>
                                            <TextBlock Text="{Binding Content}" TextWrapping="Wrap" FontSize="14" LineHeight="21"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                <Button Content="⧉" ToolTip="Copiar mensagem"
                                                        Style="{StaticResource MessageIconButton}"
                                                        Click="CopyMessage_Click" Tag="{Binding Content}"/>
                                                <Button Content="↩" ToolTip="Mencionar mensagem"
                                                        Style="{StaticResource MessageIconButton}"
                                                        Command="{Binding DataContext.MentionMessageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Content="↻" ToolTip="Gerar outra resposta"
                                                        Style="{StaticResource MessageIconButton}"
                                                        Command="{Binding DataContext.RegenerateResponseCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>

                    <Grid Grid.Row="3" Margin="28,12,28,25">
                        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="18" BorderBrush="#3055E6FF"
                                BorderThickness="1" Padding="7">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="+" Style="{StaticResource HoverCardButton}"
                                        Width="42" Height="42" FontSize="24" Padding="0"
                                        ToolTip="Adicionar arquivos" ToolTipService.InitialShowDelay="1000"
                                        Click="AddFile_Click"/>
                                <Button Grid.Column="1" Content="/" Style="{StaticResource HoverCardButton}"
                                        Width="42" Height="42" FontSize="20" Padding="0"
                                        ToolTip="Comandos do VORTEX" ToolTipService.InitialShowDelay="1000"
                                        Click="SlashCommand_Click"/>
                                <Button Grid.Column="2" x:Name="MicrophoneButton" Content="●"
                                        Style="{StaticResource HoverCardButton}" Width="42" Height="42"
                                        FontSize="16" Foreground="#FFFFFF"
                                        ToolTip="Falar com o VORTEX" ToolTipService.InitialShowDelay="1000"
                                        Click="Microphone_Click"/>
                                <Button Grid.Column="3" x:Name="MuteVoiceButton" Content="◖"
                                        Style="{StaticResource HoverCardButton}" Width="42" Height="42"
                                        FontSize="18" Foreground="#FFFFFF"
                                        ToolTip="Mutar voz da IA" ToolTipService.InitialShowDelay="1000"
                                        Click="MuteVoice_Click"/>
                                <TextBox Grid.Column="4" x:Name="ChatInput" Text="{Binding UserInput, UpdateSourceTrigger=PropertyChanged}"
                                         Background="Transparent" Foreground="#F3F6FC" CaretBrush="#55E6FF"
                                         BorderThickness="0" Padding="15,12" FontSize="14"
                                         VerticalContentAlignment="Center" AcceptsReturn="False">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding SendMessageCommand}"/>
                                    </TextBox.InputBindings>
                                </TextBox>
                                <Button Grid.Column="5" Content="↑" Command="{Binding SendMessageCommand}"
                                        Width="43" Height="43" Margin="4" FontSize="21" FontWeight="Bold"
                                        Foreground="White" Background="#7C3AED" BorderThickness="0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="22">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Border>
                        <Popup x:Name="CommandPopup" PlacementTarget="{Binding ElementName=ChatInput}"
                               Placement="Top" StaysOpen="False" AllowsTransparency="True">
                            <Border Background="#F20D0D0D" BorderBrush="#444444" BorderThickness="1"
                                    CornerRadius="14" Padding="8" Width="330" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="Comandos" FontWeight="SemiBold" Margin="8,5,8,8"/>
                                    <Button Content="/terminal  Executar um comando" Tag="/terminal "
                                            Style="{StaticResource HoverCardButton}" HorizontalContentAlignment="Left"
                                            Click="CommandOption_Click"/>
                                    <Button Content="/spotify  Controlar reprodução" Tag="/spotify "
                                            Style="{StaticResource HoverCardButton}" HorizontalContentAlignment="Left"
                                            Click="CommandOption_Click"/>
                                    <Button Content="/objetivo  Criar um objetivo" Tag="/objetivo "
                                            Style="{StaticResource HoverCardButton}" HorizontalContentAlignment="Left"
                                            Click="CommandOption_Click"/>
                                    <Button Content="/computer-use  Controlar a interface com confirmação" Tag="/computer-use "
                                            Style="{StaticResource HoverCardButton}" HorizontalContentAlignment="Left"
                                            Click="CommandOption_Click"/>
                                </StackPanel>
                            </Border>
                        </Popup>
                        <TextBlock Text="Enter para enviar" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                   Margin="0,0,58,-17" FontSize="9" Foreground="{StaticResource MutedTextBrush}"/>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="4" Background="#000000" BorderBrush="#333333"
                    BorderThickness="1,0,0,0" CornerRadius="0" Padding="14">
                <TabControl Background="Transparent" Foreground="#FFFFFF">
                    <TabItem Header="Explorador">
                        <Grid Margin="0,12,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBox Text="{Binding GlobalSearch, UpdateSourceTrigger=PropertyChanged}"
                                     Background="#101522" Foreground="#FFFFFF" CaretBrush="#55E6FF"
                                     BorderBrush="#3055E6FF" Padding="10,8"
                                     ToolTip="Pesquisa global na Workspace"/>
                            <ListBox Grid.Row="1" ItemsSource="{Binding FilteredWorkspaceFiles}"
                                     Background="Transparent" Foreground="#FFFFFF"
                                     BorderThickness="0" Margin="0,10,0,0"
                                     FontFamily="Consolas" FontSize="11"/>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Alterações">
                        <Grid Margin="0,12,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <ListBox ItemsSource="{Binding PendingChangePreviews}"
                                     Background="Transparent" Foreground="#FFFFFF"
                                     BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#151D2B" BorderBrush="#33465F"
                                                BorderThickness="1" CornerRadius="8" Padding="9" Margin="0,0,0,8">
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap"
                                                       FontFamily="Consolas" FontSize="10" Foreground="#FFFFFF"
                                                       MaxHeight="260"/>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Cancelar" Command="{Binding CancelChangesCommand}"
                                        Padding="10,6" Margin="0,0,7,0"/>
                                <Button Content="Aplicar tudo" Command="{Binding ApplyAllChangesCommand}"
                                        Padding="12,6" Background="#7C4DFF" Foreground="#FFFFFF"/>
                            </StackPanel>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <Grid x:Name="OverlayHost" Visibility="Collapsed" Panel.ZIndex="100"
              Background="#F2030303">
            <Border Margin="70,48" Background="#090909" BorderBrush="#464646"
                    BorderThickness="1" CornerRadius="22">
                <Grid>
                    <ContentControl x:Name="OverlayContent" Margin="0,46,0,0"/>
                    <Button Content="×" Click="CloseOverlay_Click"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Width="36" Height="36" Margin="0,9,12,0"
                            Background="#181818" Foreground="#FFFFFF"
                            BorderBrush="#4A4A4A" FontSize="22"
                            ToolTip="Fechar painel"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
